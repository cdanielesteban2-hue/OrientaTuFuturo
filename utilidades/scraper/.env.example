# ==============================================================================
# Variables de Entorno para el Módulo de Web Scraping - OrientaTuFuturo
# Copiar este archivo como .env en este mismo directorio o en la raíz del proyecto
# ==============================================================================

# Entorno de ejecución: 'local' o 'production'
SCRAPER_ENV=local

# Configuración de Base de Datos MySQL (Local por defecto XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=orienta_tu_futuro

# Parámetros de resiliencia y delays (segundos)
MIN_DELAY_SECONDS=2.0
MAX_DELAY_SECONDS=5.0
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# Configuración de Playwright / Headless
HEADLESS_BROWSER=True
